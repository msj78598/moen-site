# إعدادات العامل (worker) — انسخه إلى .env.worker واملأ القيم.
# ⚠️ .env.worker مستثنى من Git. لا ترفعه ولا تضع مفتاحه في المتصفح.

SUPABASE_URL=https://ersztjnggcreaiylrswv.supabase.co

# للقراءة فقط (كافٍ لوكيل المراقبة، لكنه يرى الصفوف المنشورة فقط بسبب RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# للكتابة والرؤية الكاملة. يتجاوز RLS — لا يُمرَّر إلى أي نموذج لغة أبدًا.
# SUPABASE_SERVICE_ROLE_KEY=

# الذكاء الاصطناعي: none | ollama
# النظام يعمل بالكامل بدون نموذج. none هو الوضع الافتراضي المقصود.
LLM_PROVIDER=none
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_REQUIRED=false

RUN_TIME_ZONE=Asia/Riyadh
LOG_LEVEL=info
# WORKER_DRY_RUN=true  -> الأدوات الكاتبة تُسجَّل ولا تُنفَّذ
WORKER_DRY_RUN=false
